# Copy thành .env rồi sửa. KHÔNG đưa file .env lên GitHub.
# Tạo token:  openssl rand -hex 24
DEVICE_TOKEN=thay-bang-chuoi-ngau-nhien-dai
ADMIN_TOKEN=thay-bang-token-quan-tri-rieng
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=parking
MYSQL_PASSWORD=thay-bang-mat-khau-mysql
MYSQL_DATABASE=smart_parking
PORT=3000
PAYMENT_SIMULATION=1   # 1: bấm thanh toán mở cổng ra không cần IR; 0: cần xe tại IR
FEE_PER_HOUR=10000
SECS_PER_HOUR=60       # chu kỳ tính phí mô phỏng: 60 giây = 1 "giờ"; dùng 3600 cho giờ thật
HOLD_SECONDS=30        # số giây giữ mã trước khi vào bãi; thay HOLD_MIN cũ
TRUST_PROXY=1          # số proxy đứng trước Node (Nginx = 1; Nginx sau HAProxy/Cloudflare = 2)
